[Unit]
Description=Blob Intake managed scanner worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/blob-intake
ExecStart=/absolute/path/to/node --env-file=/absolute/path/to/blob-intake/runtime/worker.env --import tsx scripts/scanner-worker.ts
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
CPUQuota=50%
TasksMax=32
TimeoutStopSec=20

[Install]
WantedBy=default.target
